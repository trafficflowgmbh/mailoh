{
  "productName": "mailoh",
  "version": "0.1.0",
  "identifier": "io.mailoh.desktop.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "mailoh",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 TrafficFlow GmbH",
    "publisher": "TrafficFlow GmbH",
    "shortDescription": "Consent-first email — interface preview",
    "longDescription": "mailoh is consent-first email on the mailboxes you already have. This preview renders the complete interface on a small fictional mailbox that ships inside the app: there is no IMAP client, no HTTP client and no telemetry in this build.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
