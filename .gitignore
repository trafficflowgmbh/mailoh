# Local build output: the engine bundle, the vendored Node runtime and the
# packaged artifacts all land here.
build/

# The app (apps/desktop): npm deps, the UI bundle, Rust output, and the ACL
# schemas tauri-build regenerates on every compile. The Tauri lockfile is the
# one npm regenerates in apps/desktop; the ROOT package-lock.json is published
# on purpose — `npm ci` in every CI job installs from it — so it must NOT be
# ignored.
node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/package-lock.json


# macOS
.DS_Store
