{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/sidecar/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/api/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/db-mail/src/**/*.ts",
    "packages/services/src/**/*.ts"
  ]
}
